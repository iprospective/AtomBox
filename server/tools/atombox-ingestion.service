# managed-by: server/tools/deploy-apache.sh (AtomBox) — __SERVER__ est remplacé au déploiement
[Unit]
Description=AtomBox — le démon d'ingestion IMAP
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=mathieu
Group=mathieu
WorkingDirectory=__SERVER__
EnvironmentFile=/etc/atombox/env
ExecStart=__SERVER__/.venv/bin/python -m atombox.ingestion.daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
