# managed-by: server/tools/deploy-apache.sh (AtomBox) — __SERVER__, __USER__ et __VENV__ sont remplacés au déploiement (render-unit.sh)
[Unit]
Description=AtomBox — app --host 127.0.0.1 --port 8010:l'API et le webmail
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=__USER__
Group=__USER__
WorkingDirectory=__SERVER__
EnvironmentFile=/etc/atombox/env
ExecStart=__VENV__/bin/uvicorn atombox.api.app:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
