# managed-by: server/tools/deploy-apache.sh (AtomBox) — __SERVER__ est remplacé au déploiement
[Unit]
Description=AtomBox — les événements, envois et tâches cadencées
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=mathieu
Group=mathieu
WorkingDirectory=__SERVER__
EnvironmentFile=/etc/atombox/env
ExecStart=__SERVER__/.venv/bin/python -m atombox.tasks
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
