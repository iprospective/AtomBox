# managed-by: serveur/outils/deployer-apache.sh (AtomBox) — __SERVEUR__ est remplacé au déploiement
[Unit]
Description=AtomBox — app --host 127.0.0.1 --port 8010:l'API et le webmail
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=mathieu
Group=mathieu
WorkingDirectory=__SERVEUR__
EnvironmentFile=/etc/atombox/env
ExecStart=__SERVEUR__/.venv/bin/uvicorn atombox.api.app:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
