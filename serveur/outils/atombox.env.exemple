# /etc/atombox/env — l'environnement des trois processus (D161). Copié par deployer-apache.sh s'il n'existe pas.
# Les secrets vivent ICI, jamais en base (D149) ; ce fichier est en 640 root:mathieu.
DATABASE_URL=postgresql:///atombox
ATOMBOX_STORE=/var/lib/atombox/magasin
ATOMBOX_LOGS=/var/log/atombox
ATOMBOX_LOG_LEVEL=info
# ATOMBOX_LOG_LEVELS=imap=debug,auth=info
# la relève IMAP (F001) : le compte master du serveur de courrier (chapitre 06)
ATOMBOX_IMAP_HOST=
ATOMBOX_IMAP_PORT=993
ATOMBOX_IMAP_MASTER=masteruser                  # vide (ou = l'adresse de la boîte) : connexion par l'adresse et son propre mot de passe
ATOMBOX_IMAP_PASSWORD=
# ATOMBOX_PART=1/1                       # partition des boîtes entre plusieurs démons
# l'émission (F109) : le relais du client (D114)
ATOMBOX_SMTP_HOST=
ATOMBOX_SMTP_PORT=587
ATOMBOX_SMTP_USER=
ATOMBOX_SMTP_PASSWORD=
ATOMBOX_SMTP_TLS=starttls

# L'adresse d'émission des messages de SERVICE (réinitialisation de mot de passe, et demain les
# codes de second facteur). Elle doit appartenir à un domaine AUTHENTIFIÉ — SPF qui autorise le
# relais, et DKIM : Gmail et Outlook refusent le courrier non authentifié, en IPv6 en particulier.
# Un domaine sans SPF n'est pas « un peu moins bien classé » : ses messages n'arrivent pas.
# Absente, l'adresse est dérivée du domaine de la boîte du compte — ce qui n'est juste que si CE
# domaine est authentifié.
ATOMBOX_SERVICE_SENDER=

# L'URL publique du webmail, base des liens envoyés par courrier. Absente, elle est reconstruite
# depuis les en-têtes du proxy (X-Forwarded-Proto + Host) ; derrière Apache avec ProxyPreserveHost,
# c'est correct. À poser explicitement si le webmail est servi sous plusieurs noms.
ATOMBOX_PUBLIC_URL=

# --- le serveur IMAP d'AtomBox (D180, lecture seule) -------------------------------------------
# PRÉFIXE `IMAPD`, à ne pas confondre avec les `ATOMBOX_IMAP_*` ci-dessus, qui désignent le serveur
# du FOURNISSEUR qu'AtomBox relève. La même confusion avait déjà coûté cher sur les UID.
# ATTENTION EN CONTENEUR : 127.0.0.1 est la boucle locale DU CONTENEUR. Un client sur l'hôte ne
# voit rien. Pour tester depuis la machine hôte, écouter sur l'adresse du conteneur (ip -4 addr).
# Tout passe alors EN CLAIR, mot de passe compris : acceptable sur un pont privé, nulle part ailleurs.
ATOMBOX_IMAPD_LISTEN=127.0.0.1
# PAS 143 : un Dovecot tourne déjà sur cette machine, et deux serveurs sur le même port,
# c'est le second qui ne démarre pas. 1993 avec TLS.
ATOMBOX_IMAPD_PORT=1143
#ATOMBOX_IMAPD_CERT=/etc/atombox/imap.crt
#ATOMBOX_IMAPD_KEY=/etc/atombox/imap.key
ATOMBOX_IMAPD_MAX=20
